# Applied to every route below by withCommonMiddleware (server/http.go):
COMMON  *                                             [secureHeadersMiddleware Cors.Handler]

# * = registered on the chain but NOT enforcing on that path.
# RequireAuth only rejects the paths auth.EnforcesAuth covers (/api/*, /docs/*);
# every other path passes through so the SPA shell can render and detect auth
# state via /api/auth/session. A route that must be protected therefore has to be
# covered by that predicate, not merely sit on a chain that contains RequireAuth.

GET     /                                             [RequireAuth* RequireCSRFHeader]
POST    /api/auth/login                               [RequireCSRFHeader]
POST    /api/auth/logout                              [RequireAuth RequireCSRFHeader]
POST    /api/auth/password                            [RequireAuth RequireCSRFHeader]
GET     /api/auth/session                             [RequireAuth RequireCSRFHeader]
POST    /api/auth/setup                               [RequireCSRFHeader]
GET     /api/auth/users                               [RequireAuth RequireCSRFHeader RequireRole]
POST    /api/auth/users                               [RequireAuth RequireCSRFHeader RequireRole]
DELETE  /api/auth/users/{id}                          [RequireAuth RequireCSRFHeader RequireRole]
GET     /api/blocking/disable                         [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/blocking/enable                          [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/blocking/status                          [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/cache/flush                              [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/config/apply                             [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/block-settings                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/block-settings                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/blocklist-sources                 [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/config/blocklist-sources                 [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/blocklist-sources/{id}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/blocklist-sources/{id}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/blocklist-sources/{id}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/client-groups                     [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/client-groups/{name}              [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/client-groups/{name}              [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/client-groups/{name}              [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/custom-dns                        [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/config/custom-dns                        [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/custom-dns/{id}                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/custom-dns/{id}                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/custom-dns/{id}                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/domain-entries                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/config/domain-entries                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/domain-entries/{id}               [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/domain-entries/{id}               [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/domain-entries/{id}               [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/upstream-groups                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/upstream-groups/{name}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/upstream-groups/{name}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/upstream-groups/{name}            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/upstream-groups/{name}/servers    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/config/upstream-groups/{name}/servers    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
DELETE  /api/config/upstream-groups/{name}/servers/{id} [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/upstream-groups/{name}/servers/{id} [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/config/upstream-settings                 [RequireAuth RequireCSRFHeader RequireAdminForMutations]
PUT     /api/config/upstream-settings                 [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/discovered-clients                       [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/endpoint-info                            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
POST    /api/lists/refresh                            [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/mobileconfig/{slug}                      [public]
POST    /api/query                                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats                                    [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/overtime                           [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/overtime/clients                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/overtime/latency                   [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/query-types                        [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/response-types                     [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/top-clients                        [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/stats/top-domains                        [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/version                                  [RequireAuth RequireCSRFHeader RequireAdminForMutations]
GET     /api/ws/logs                                  [RequireAuth RequireCSRFHeader]
GET     /dns-query                                    [public]
POST    /dns-query                                    [public]
GET     /dns-query/                                   [public]
POST    /dns-query/                                   [public]
GET     /dns-query/{clientID}                         [public]
POST    /dns-query/{clientID}                         [public]
GET     /docs/config.schema.json                      [RequireAuth RequireCSRFHeader]
GET     /docs/openapi.yaml                            [RequireAuth RequireCSRFHeader]
ANY     /metrics                                      [public]
ANY     /robots.txt                                   [RequireAuth* RequireCSRFHeader]
ANY     /static/*                                     [RequireAuth* RequireCSRFHeader]
GET     /ui                                           [RequireAuth* RequireCSRFHeader]
ANY     /ui/*                                         [RequireAuth* RequireCSRFHeader]
